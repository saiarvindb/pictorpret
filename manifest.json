{
	"manifest_version": 3,
	"name": "Pictorpret",
	"version": "1.0",
	"background" :
	{
		"scripts" : ["./background.js"]
	},
	"content_scripts" :
	[
		{
			"matches" : ["<all_urls>"],
			"js" : ["./content.js"]
		}
	],
	"action":
	{
		"default_popup": "./popup.html"
	},
	"host_permissions" :
	[
		"<all_urls>"
	]
}
